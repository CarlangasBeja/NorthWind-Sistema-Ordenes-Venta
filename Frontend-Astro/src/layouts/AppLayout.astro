---
import '../styles/global.css';
interface Props { title: string; subtitle?: string; auth?: boolean; active?: string; }
const { title, subtitle = '', auth = false, active = '' } = Astro.props;
const navIcons: Record<string, string> = {
 dashboard: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
 createorder: '<path d="M6 3h12l2 5-2 13H6L4 8l2-5Z"/><path d="M4 8h16M9 12v5m6-5v5"/>',
 customers: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
 products: '<path d="M12 2 3 7l9 5 9-5-9-5ZM3 7v10l9 5 9-5V7M12 12v10"/>',
 invoices: '<path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3ZM9 8h6m-6 4h6"/>'
};
const menu = [
  { href: '/', id: 'dashboard', icon: 'layout-dashboard', label: 'Inicio' },
  { href: '/createorder', id: 'createorder', icon: 'shopping-bag', label: 'Nueva orden' },
  { href: '/customers', id: 'customers', icon: 'users-round', label: 'Clientes' },
  { href: '/products', id: 'products', icon: 'package', label: 'Productos' },
  { href: '/invoices', id: 'invoices', icon: 'receipt-text', label: 'Historial de órdenes' }
];
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0c1b2d" />
  <meta name="description" content="NorthWind — Gestión profesional de ventas y clientes" />
  <title>{title} · NorthWind</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body data-auth={auth ? 'public' : 'required'} data-page={active}>
  <div class:list={['app', {'auth-only':auth}]}>
    {!auth && <>
      <div id="sidebar-overlay" class="sidebar-overlay"></div>
      <aside class="sidebar" id="sidebar" aria-label="Navegación principal">
        <a href="/" class="brand"><span class="brand-icon">N<span>W</span></span><span class="brand-text">North<span>Wind</span><small>COMMERCE SYSTEM</small></span></a>
        <div class="workspace-switch"><span class="work-icon">▦</span><span><strong>Espacio de trabajo</strong><small>Gestión comercial</small></span><span class="workspace-dot"></span></div>
        <div class="nav-caption">GENERAL</div>
        <nav class="nav-list">
          {menu.map((item,i) => <>
            {i === 2 && <div class="nav-caption nav-caption-mid">CATÁLOGOS</div>}
            {i === 4 && <div class="nav-caption nav-caption-mid">CONSULTAS</div>}
            <a href={item.href} class:list={['nav-link',{'active':active===item.id}]} data-icon={item.icon}><span class="nav-emoji" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={navIcons[item.id]} /></span><span>{item.label}</span>{active===item.id && <span class="nav-current"></span>}</a>
          </>)}
        </nav>
        <div class="sidebar-foot"><div class="sidebar-help"><span class="help-dot">✦</span><strong>NorthWind 2.0</strong><small>Frontend desarrollado con Astro. API .NET 8 conectada.</small></div><div class="sidebar-version">ASTRO EDITION <span>v1.0</span></div></div>
      </aside>
    </>}
    <div class="main-shell">
      {!auth && <header class="topbar">
        <div class="topbar-left"><button id="menu-toggle" type="button" class="icon-button menu-button" aria-label="Abrir menú">☰</button><div class="breadcrumb"><span>NorthWind</span><span class="slash">/</span><strong>{title}</strong></div></div>
        <div class="topbar-right"><span class="environment" id="api-status" data-status="checking" role="status" aria-live="polite"><span class="status-led"></span><span id="api-status-label">Comprobando API</span></span><button id="theme-toggle" type="button" class="icon-button" title="Cambiar apariencia" aria-label="Cambiar modo claro u oscuro"><span id="theme-icon">☾</span></button><div class="user-small"><span id="user-avatar" class="avatar">U</span><span><strong id="user-name">Usuario</strong><small>Sesión activa</small></span></div><button id="logout" class="button-logout" title="Cerrar sesión">Salir <span>↗</span></button></div>
      </header>}
      <main class:list={['content', {'content-auth':auth}]}>
        {!auth && <div class="page-intro"><div><div class="eyebrow"><span class="eyebrow-line"></span> PLATAFORMA DE VENTAS</div><h1>{title}</h1>{subtitle && <p>{subtitle}</p>}</div><div class="page-date" id="today-label"></div></div>}
        <slot/>
        {!auth && <footer class="footer"><span>© 2026 NorthWind · Gestión comercial</span><span>Diseñado en Astro · Conectado con ASP.NET Core</span></footer>}
      </main>
    </div>
  </div>
  <div id="toast-container" aria-live="polite" aria-atomic="false"></div>
  <div id="modal-root"></div>
  <script src="../scripts/shell.ts"></script>
</body>
</html>
