@page "/products"
@attribute [Authorize]
@inject ISalesQueriesGateway Gateway

<PageTitle>Productos | NorthWind</PageTitle>

<div class="nw-page-heading">
    <div>
        <span class="nw-kicker">CATÁLOGO DE PRODUCTOS</span>
        <h1>Productos e inventario</h1>
        <p>Consulte el código real, descripción, precio de venta y stock de todos los productos registrados, incluso los agotados.</p>
    </div>
    <a class="btn btn-primary" href="/createorder">＋ Crear orden</a>
</div>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="nw-feedback nw-feedback-danger mb-4" role="alert"><div class="nw-feedback-icon">!</div><div class="nw-feedback-body"><strong>No pudimos cargar el catálogo</strong><p>@ErrorMessage</p></div><button class="nw-feedback-close" @onclick="() => ErrorMessage = string.Empty" aria-label="Cerrar mensaje">×</button></div>
}

<section class="nw-card">
    <div class="nw-card-header nw-card-header-actions"><div><span class="nw-step">01</span><div><h2>Explorar productos</h2><p>Filtros por identificador y nombre; las existencias se leen de NorthWindDB.</p></div></div><span class="nw-status-pill nw-status-neutral">@(Result?.TotalItems ?? 0) resultados</span></div>
    <div class="nw-catalog-toolbar">
        <div class="nw-catalog-filters">
            <label class="form-label" for="productField">Buscar por</label>
            <select id="productField" class="form-select" @bind="SearchField"><option value="all">Código o nombre</option><option value="id">Solo código</option><option value="name">Solo nombre</option></select>
        </div>
        <div class="nw-catalog-search"><label class="form-label" for="productSearch">Texto de búsqueda</label><input id="productSearch" class="form-control" placeholder="Ej.: 15 o Leche" @bind="SearchText" @bind:event="oninput" @onkeydown="OnSearchKeyDown" /></div>
        <button class="btn btn-primary" type="button" disabled="@Busy" @onclick="Search">@(Busy ? "Buscando..." : "Buscar productos")</button>
        <button class="btn btn-outline-secondary" type="button" disabled="@Busy" @onclick="Clear">Limpiar</button>
    </div>
    @if (Busy)
    {
        <div class="nw-loading-block"><span class="nw-spinner"></span><strong>Cargando productos...</strong></div>
    }
    else if (Result is null || Result.Items.Count == 0)
    {
        <div class="nw-empty-block"><strong>No encontramos productos</strong><span>Pruebe otro nombre o código.</span></div>
    }
    else
    {
        <div class="table-responsive nw-table-shell">
            <table class="table table-hover align-middle nw-data-table mb-0">
                <thead><tr><th>Código</th><th>Nombre del producto</th><th class="text-end">Precio unitario</th><th class="text-end">Stock</th><th>Disponibilidad</th></tr></thead>
                <tbody>
                @foreach (var product in Result.Items)
                {
                    <tr>
                        <td data-label="Código"><span class="nw-code-chip">#@product.Id</span></td>
                        <td data-label="Producto"><strong>@product.Name</strong></td>
                        <td data-label="Precio" class="text-end"><strong>@Money(product.UnitPrice)</strong></td>
                        <td data-label="Stock" class="text-end">@product.UnitsInStock</td>
                        <td data-label="Disponibilidad">
                            @if (product.UnitsInStock == 0)
                            { <span class="nw-status-pill nw-status-warning">Agotado</span> }
                            else if (product.UnitsInStock <= 5)
                            { <span class="nw-status-pill nw-status-warning">Stock bajo</span> }
                            else
                            { <span class="nw-status-pill nw-status-success">Disponible</span> }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="nw-pagination">
            <button type="button" class="btn btn-outline-secondary" disabled="@(Busy || Result.Page <= 1)" @onclick="Previous">← Anterior</button>
            <span>Página <strong>@Result.Page</strong> de <strong>@Math.Max(1, Result.TotalPages)</strong></span>
            <button type="button" class="btn btn-outline-secondary" disabled="@(Busy || Result.Page >= Result.TotalPages)" @onclick="Next">Siguiente →</button>
        </div>
    }
</section>

@code {
    private const int PageSize = 10;
    private string SearchField = "all";
    private string SearchText = string.Empty;
    private string ErrorMessage = string.Empty;
    private bool Busy;
    private PagedResultDto<ProductSearchItemDto>? Result;
    private static string Money(decimal value) => $"$ {value:N2}";
    protected override async Task OnInitializedAsync() => await Load(1);
    private Task Search() => Load(1);
    private async Task Clear() { SearchText = string.Empty; SearchField = "all"; await Load(1); }
    private async Task OnSearchKeyDown(KeyboardEventArgs args) { if (args.Key == "Enter" && !Busy) await Search(); }
    private Task Previous() => Load(Math.Max(1, (Result?.Page ?? 1) - 1));
    private Task Next() => Load((Result?.Page ?? 0) + 1);
    private async Task Load(int page)
    {
        Busy = true; ErrorMessage = string.Empty;
        try { Result = await Gateway.SearchProductsAsync(SearchText.Trim(), SearchField, page, PageSize, includeOutOfStock: true); }
        catch (Exception ex) { ErrorMessage = ex is HttpRequestException e && e.StatusCode == System.Net.HttpStatusCode.Unauthorized ? "Inicie sesión para consultar productos." : ex.Message; }
        finally { Busy = false; }
    }
}
