@page "/invoices"
@attribute [Authorize]
@inject ISalesQueriesGateway Gateway
@inject IJSRuntime JS

<PageTitle>Órdenes de venta | NorthWind Ventas</PageTitle>

<div class="nw-page-heading">
    <div>
        <span class="nw-kicker">HISTORIAL DE VENTAS</span>
        <h1>Consultar órdenes de venta</h1>
        <p>Localice una orden de venta con filtros precisos, revise su detalle y genere un comprobante profesional.</p>
    </div>
    <a class="btn btn-primary nw-btn-icon" href="/createorder"><span aria-hidden="true">＋</span>Nueva orden</a>
</div>

@if (!string.IsNullOrWhiteSpace(InformationMessage))
{
    <div class="nw-feedback nw-feedback-success" role="status">
        <div class="nw-feedback-icon">✓</div>
        <div class="nw-feedback-body"><strong>Operación completada</strong><p>@InformationMessage</p></div>
        <button type="button" class="nw-feedback-close" @onclick="ClearMessages" aria-label="Cerrar notificación">×</button>
        <span class="nw-toast-progress" aria-hidden="true"></span>
    </div>
}

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="nw-feedback nw-feedback-danger" role="alert">
        <div class="nw-feedback-icon">×</div>
        <div class="nw-feedback-body">
            <strong>No pudimos completar la operación</strong>
            <p>@ErrorMessage</p>
            <button type="button" class="btn btn-sm btn-outline-danger mt-2" @onclick="RetryAsync">Reintentar</button>
        </div>
        <button type="button" class="nw-feedback-close" @onclick="ClearMessages" aria-label="Cerrar notificación">×</button>
        <span class="nw-toast-progress" aria-hidden="true"></span>
    </div>
}

<section class="nw-card mb-4 nw-invoice-search-card">
    <div class="nw-card-header nw-card-header-actions">
        <div>
            <span class="nw-step">01</span>
            <div>
                <h2>Localizar orden de venta</h2>
                <p>Seleccione un criterio para evitar resultados ambiguos.</p>
            </div>
        </div>
        @if (Result is not null)
        {
            <span class="nw-status-pill nw-status-neutral">@Result.TotalItems orden(es)</span>
        }
    </div>

    <div class="nw-filter-panel nw-filter-panel-page">
        <div class="nw-filter-heading">
            <div>
                <strong>Filtro de búsqueda</strong>
                <span>Puede cambiar de criterio en cualquier momento.</span>
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearSearchAsync" disabled="@IsLoading">Restablecer</button>
        </div>

        <div class="nw-filter-options nw-filter-options-invoices" role="group" aria-label="Criterio para consultar órdenes de venta">
            <button type="button" class="nw-filter-chip @(SearchField == "all" ? "is-active" : string.Empty)" @onclick="SearchAllAsync">
                <span class="nw-filter-chip-icon">⌕</span>
                <span><strong>Todos</strong><small>Búsqueda flexible</small></span>
            </button>
            <button type="button" class="nw-filter-chip @(SearchField == "invoice" ? "is-active" : string.Empty)" @onclick="SearchByInvoiceAsync">
                <span class="nw-filter-chip-icon">№</span>
                <span><strong>N.º de orden</strong><small>INV-000001</small></span>
            </button>
            <button type="button" class="nw-filter-chip @(SearchField == "customercode" ? "is-active" : string.Empty)" @onclick="SearchByCustomerCodeAsync">
                <span class="nw-filter-chip-icon">#</span>
                <span><strong>Código cliente</strong><small>Ej.: ALFKI</small></span>
            </button>
            <button type="button" class="nw-filter-chip @(SearchField == "customername" ? "is-active" : string.Empty)" @onclick="SearchByCustomerNameAsync">
                <span class="nw-filter-chip-icon">Aa</span>
                <span><strong>Nombre cliente</strong><small>Nombre parcial</small></span>
            </button>
        </div>

        <div class="nw-smart-search-row nw-smart-search-row-page">
            <div class="nw-search-input-wrap">
                <span class="nw-search-input-icon">⌕</span>
                <input class="form-control form-control-lg"
                       value="@SearchText"
                       @oninput="OnSearchInput"
                       @onkeydown="HandleSearchKeyDown"
                       placeholder="@SearchPlaceholder"
                       aria-label="Consultar órdenes de venta" />
                @if (!string.IsNullOrWhiteSpace(SearchText))
                {
                    <button type="button" class="nw-input-clear" @onclick="ClearTextAsync" aria-label="Limpiar texto">×</button>
                }
            </div>
            <button type="button" class="btn btn-primary px-4" @onclick="SearchAsync" disabled="@IsLoading">
                @(IsLoading ? "Consultando..." : "Buscar orden")
            </button>
        </div>

        <div class="nw-filter-help">
            <span class="nw-info-icon">i</span>
            <span>@SearchHelp</span>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="nw-loading-block mt-3">
            <span class="nw-spinner" aria-hidden="true"></span>
            <strong>Consultando órdenes de venta...</strong>
            <span>Estamos recuperando las órdenes registradas.</span>
        </div>
    }
    else if (string.IsNullOrWhiteSpace(ErrorMessage) && (Result is null || Result.Items.Count == 0))
    {
        <div class="nw-empty-block mt-3">
            <div class="nw-empty-icon">▤</div>
            <strong>No encontramos órdenes de venta</strong>
            <span>@EmptyMessage</span>
        </div>
    }
    else if (string.IsNullOrWhiteSpace(ErrorMessage) && Result is not null)
    {
        <div class="nw-result-meta mt-2">
            <span><strong>@Result.TotalItems</strong> resultado(s) · más recientes primero</span>
            <span>Página @Result.Page de @(Math.Max(Result.TotalPages, 1))</span>
        </div>

        <div class="table-responsive nw-table-shell nw-invoice-table-shell">
            <table class="table table-hover align-middle nw-data-table mb-0">
                <thead>
                    <tr>
                        <th>Orden</th>
                        <th>Fecha</th>
                        <th>Cliente</th>
                        <th class="text-end">Subtotal</th>
                        <th class="text-end">IVA</th>
                        <th class="text-end">Total</th>
                        <th class="text-end">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var invoice in Result.Items)
                    {
                        <tr>
                            <td data-label="Orden"><span class="nw-code-chip">@invoice.InvoiceNumber</span></td>
                            <td data-label="Fecha">
                                <strong>@invoice.OrderDate.ToString("dd/MM/yyyy")</strong>
                                <small class="d-block text-secondary">@invoice.OrderDate.ToString("HH:mm")</small>
                            </td>
                            <td data-label="Cliente">
                                <strong>@invoice.CustomerName</strong>
                                <small class="d-block text-secondary">@invoice.CustomerId</small>
                            </td>
                            <td data-label="Subtotal" class="text-end">@Money(invoice.Subtotal)</td>
                            <td data-label="IVA" class="text-end">@Money(invoice.Tax)</td>
                            <td data-label="Total" class="text-end"><strong class="nw-money-emphasis">@Money(invoice.Total)</strong></td>
                            <td data-label="Acción" class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-primary nw-btn-icon" @onclick="() => OpenInvoiceAsync(invoice.OrderId)" disabled="@IsInvoiceLoading">
                                    <span aria-hidden="true">▣</span>Ver orden de venta generada
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="nw-pagination">
            <button type="button" class="btn btn-outline-secondary" disabled="@(Result.Page <= 1 || IsLoading)" @onclick="PreviousPageAsync">← Anterior</button>
            <span>Página <strong>@Result.Page</strong> de <strong>@(Math.Max(Result.TotalPages, 1))</strong> · @Result.TotalItems resultado(s)</span>
            <button type="button" class="btn btn-outline-secondary" disabled="@(Result.Page >= Result.TotalPages || IsLoading)" @onclick="NextPageAsync">Siguiente →</button>
        </div>
    }
</section>

@if (IsInvoiceLoading)
{
    <div class="nw-modal-backdrop">
        <section class="nw-modal nw-confirm-modal" role="status" aria-live="polite">
            <span class="nw-spinner" aria-hidden="true"></span>
            <h2>Preparando orden de venta</h2>
            <p>Estamos cargando los productos, datos de entrega y totales.</p>
        </section>
    </div>
}

@if (ShowInvoiceModal && SelectedInvoice is not null)
{
    <div class="nw-modal-backdrop">
        <section class="nw-modal nw-invoice-detail-modal" role="dialog" aria-modal="true" aria-labelledby="invoiceDetailTitle">
            <header class="nw-modal-header nw-invoice-modal-header">
                <div class="nw-invoice-modal-title">
                    <span class="nw-invoice-badge">ORDEN</span>
                    <div>
                        <h2 id="invoiceDetailTitle">@SelectedInvoice.InvoiceNumber</h2>
                        <p>Emitida el @SelectedInvoice.OrderDate.ToString("dd/MM/yyyy 'a las' HH:mm")</p>
                    </div>
                </div>
                <button type="button" class="nw-icon-button" @onclick="CloseInvoiceModal" aria-label="Cerrar orden de venta">×</button>
            </header>

            <div class="nw-modal-body nw-invoice-modal-body">
                <div class="nw-invoice-identity-strip">
                    <div>
                        <span>Cliente</span>
                        <strong>@SelectedInvoice.CustomerName</strong>
                        <small>@SelectedInvoice.CustomerId</small>
                    </div>
                    <div>
                        <span>Entrega</span>
                        <strong>@SelectedInvoice.ShipAddress</strong>
                        <small>@SelectedInvoice.ShipCity, @SelectedInvoice.ShipCountry @(SelectedInvoice.ShipPostalCode ?? string.Empty)</small>
                    </div>
                    <div>
                        <span>Contenido</span>
                        <strong>@SelectedInvoice.Details.Sum(detail => detail.Quantity) unidad(es)</strong>
                        <small>@SelectedInvoice.Details.Count línea(s) de producto</small>
                    </div>
                </div>

                <div class="table-responsive nw-table-shell mt-3">
                    <table class="table align-middle nw-data-table mb-0">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Producto</th>
                                <th class="text-end">Precio</th>
                                <th class="text-end">Cantidad</th>
                                <th class="text-end">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detail in SelectedInvoice.Details)
                            {
                                <tr>
                                    <td data-label="ID"><span class="nw-code-chip">#@detail.ProductId</span></td>
                                    <td data-label="Producto"><strong>@detail.ProductName</strong></td>
                                    <td data-label="Precio" class="text-end">@Money(detail.UnitPrice)</td>
                                    <td data-label="Cantidad" class="text-end">@detail.Quantity</td>
                                    <td data-label="Subtotal" class="text-end"><strong>@Money(detail.Subtotal)</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="nw-invoice-footer nw-invoice-modal-footer">
                    <div class="nw-security-note">
                        <span aria-hidden="true">✓</span>
                        <p>Comprobante reconstruido desde la orden almacenada. Los valores mostrados corresponden a la venta registrada.</p>
                    </div>
                    <div class="nw-invoice-totals">
                        <div><span>Subtotal</span><strong>@Money(SelectedInvoice.Subtotal)</strong></div>
                        <div><span>IVA (15%)</span><strong>@Money(SelectedInvoice.Tax)</strong></div>
                        <div class="nw-grand-total"><span>Total</span><strong>@Money(SelectedInvoice.Total)</strong></div>
                    </div>
                </div>
            </div>

            <footer class="nw-modal-footer nw-invoice-actions">
                <button type="button" class="btn btn-primary nw-btn-icon" @onclick="ViewPdfAsync" disabled="@IsPdfLoading"><span>▣</span>@(IsPdfLoading ? "Preparando..." : "Ver PDF")</button>
                <button type="button" class="btn btn-outline-primary nw-btn-icon" @onclick="DownloadPdfAsync" disabled="@IsPdfLoading"><span>↓</span>Descargar</button>
                <button type="button" class="btn btn-outline-primary nw-btn-icon" @onclick="PrintPdfAsync" disabled="@IsPdfLoading"><span>⌑</span>Imprimir</button>
            </footer>
        </section>
    </div>
}

@if (ShowPdfViewer && !string.IsNullOrWhiteSpace(PdfDataUrl))
{
    <div class="nw-modal-backdrop nw-modal-backdrop-top">
        <section class="nw-modal nw-pdf-modal" role="dialog" aria-modal="true" aria-labelledby="pdfViewerTitle">
            <header class="nw-modal-header nw-pdf-toolbar">
                <div>
                    <span class="nw-kicker">VISTA PREVIA DEL COMPROBANTE</span>
                    <h2 id="pdfViewerTitle">@SelectedInvoice?.InvoiceNumber</h2>
                    <p>Revise el documento antes de imprimirlo o descargarlo.</p>
                </div>
                <div class="nw-pdf-toolbar-actions">
                    <button type="button" class="btn btn-sm btn-outline-primary nw-btn-icon" @onclick="PrintPdfAsync"><span>⌑</span>Imprimir</button>
                    <button type="button" class="btn btn-sm btn-primary nw-btn-icon" @onclick="DownloadPdfAsync"><span>↓</span>Descargar</button>
                    <button type="button" class="nw-icon-button" @onclick="ClosePdfViewer" aria-label="Cerrar visor PDF">×</button>
                </div>
            </header>
            <div class="nw-pdf-viewer">
                <iframe src="@PdfDataUrl" title="Vista previa de la orden de venta en PDF"></iframe>
            </div>
        </section>
    </div>
}

@code {
    [Parameter, SupplyParameterFromQuery] public int? OrderId { get; set; }

    private const int PageSize = 8;
    private string SearchText = string.Empty;
    private string SearchField = "all";
    private string ErrorMessage = string.Empty;
    private string InformationMessage = string.Empty;
    private bool IsLoading;
    private bool IsInvoiceLoading;
    private bool IsPdfLoading;
    private int? LoadedOrderId;
    private int? PdfOrderId;
    private PagedResultDto<OrderSearchItemDto>? Result;
    private OrderInvoiceDto? SelectedInvoice;
    private bool ShowInvoiceModal;
    private bool ShowPdfViewer;
    private string PdfDataUrl = string.Empty;
    private string PdfBase64 = string.Empty;

    private static string Money(decimal value) => $"$ {value:N2}";

    private string SearchPlaceholder => SearchField switch
    {
        "invoice" => "Ej.: INV-000001 o 1",
        "customercode" => "Ej.: ALFKI",
        "customername" => "Escriba el nombre o una parte del nombre",
        _ => "Orden, código o nombre del cliente"
    };

    private string SearchHelp => SearchField switch
    {
        "invoice" => "Buscaremos únicamente por número de orden. Puede escribir INV-000001 o solamente 1.",
        "customercode" => "Buscaremos únicamente coincidencias en el código del cliente.",
        "customername" => "Puede escribir una parte del nombre; no es necesario conocerlo completo.",
        _ => "La búsqueda flexible revisa número de orden, código y nombre del cliente."
    };

    private string EmptyMessage => string.IsNullOrWhiteSpace(SearchText)
        ? "Todavía no existen órdenes registradas o no hay información para mostrar."
        : "No hay resultados con ese criterio. Revise el dato o pruebe otro filtro.";

    protected override async Task OnParametersSetAsync()
    {
        if (Result is null)
            await LoadAsync(1);

        if (OrderId.HasValue && LoadedOrderId != OrderId.Value)
            await OpenInvoiceAsync(OrderId.Value);
    }

    private void OnSearchInput(ChangeEventArgs args) => SearchText = args.Value?.ToString() ?? string.Empty;

    private async Task HandleSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !IsLoading)
            await SearchAsync();
    }

    private Task SearchAllAsync() => ChangeFieldAsync("all");
    private Task SearchByInvoiceAsync() => ChangeFieldAsync("invoice");
    private Task SearchByCustomerCodeAsync() => ChangeFieldAsync("customercode");
    private Task SearchByCustomerNameAsync() => ChangeFieldAsync("customername");

    private async Task ChangeFieldAsync(string field)
    {
        SearchField = field;
        SearchText = string.Empty;
        SelectedInvoice = null;
        ShowInvoiceModal = false;
        await LoadAsync(1);
    }

    private async Task ClearTextAsync()
    {
        SearchText = string.Empty;
        await LoadAsync(1);
    }

    private Task SearchAsync() => LoadAsync(1);
    private Task RetryAsync() => LoadAsync(Result?.Page ?? 1);

    private async Task ClearSearchAsync()
    {
        SearchText = string.Empty;
        SearchField = "all";
        SelectedInvoice = null;
        LoadedOrderId = null;
        ShowInvoiceModal = false;
        ClearMessages();
        await LoadAsync(1);
    }

    private async Task PreviousPageAsync()
    {
        if (Result is not null && Result.Page > 1)
            await LoadAsync(Result.Page - 1);
    }

    private async Task NextPageAsync()
    {
        if (Result is not null && Result.Page < Result.TotalPages)
            await LoadAsync(Result.Page + 1);
    }

    private async Task LoadAsync(int page)
    {
        try
        {
            IsLoading = true;
            ClearMessages();
            Result = await Gateway.SearchOrdersAsync(SearchText.Trim(), SearchField, page, PageSize);
        }
        catch (HttpRequestException ex)
        {
            ErrorMessage = ex.StatusCode switch
            {
                System.Net.HttpStatusCode.Unauthorized => "Su sesión venció. Inicie sesión nuevamente antes de consultar las órdenes de venta.",
                System.Net.HttpStatusCode.Forbidden => "Su usuario no tiene permiso para consultar órdenes de venta.",
                _ => "No fue posible comunicarnos con el servicio de ventas. Verifique que la API esté ejecutándose y vuelva a intentarlo."
            };
        }
        catch
        {
            ErrorMessage = "Ocurrió un problema inesperado al consultar las órdenes de venta. Puede reintentar sin perder información.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task OpenInvoiceAsync(int orderId)
    {
        try
        {
            IsInvoiceLoading = true;
            ClearMessages();
            SelectedInvoice = await Gateway.GetOrderInvoiceAsync(orderId);
            LoadedOrderId = orderId;
            ResetPdfCacheIfNeeded(orderId);
            if (SelectedInvoice is null)
            {
                ErrorMessage = "La orden seleccionada ya no se encuentra disponible. Actualice la búsqueda e intente nuevamente.";
                return;
            }
            ShowInvoiceModal = true;
        }
        catch (HttpRequestException ex)
        {
            ErrorMessage = ex.StatusCode == System.Net.HttpStatusCode.Unauthorized
                ? "Su sesión venció. Inicie sesión nuevamente para ver el detalle de la orden de venta."
                : "No pudimos abrir el detalle de esta orden de venta. Vuelva a intentarlo.";
        }
        catch
        {
            ErrorMessage = "Ocurrió un problema inesperado al abrir la orden de venta. Vuelva a intentarlo.";
        }
        finally
        {
            IsInvoiceLoading = false;
        }
    }

    private void CloseInvoiceModal() => ShowInvoiceModal = false;

    private async Task EnsurePdfAsync()
    {
        if (SelectedInvoice is null) return;
        if (PdfOrderId == SelectedInvoice.OrderId && !string.IsNullOrWhiteSpace(PdfBase64)) return;

        var bytes = await Gateway.GetOrderPdfAsync(SelectedInvoice.OrderId);
        PdfBase64 = Convert.ToBase64String(bytes);
        PdfDataUrl = $"data:application/pdf;base64,{PdfBase64}";
        PdfOrderId = SelectedInvoice.OrderId;
    }

    private async Task ViewPdfAsync()
    {
        if (SelectedInvoice is null) return;
        try
        {
            IsPdfLoading = true;
            ClearMessages();
            await EnsurePdfAsync();
            ShowPdfViewer = true;
        }
        catch
        {
            ErrorMessage = "No pudimos generar la vista previa del PDF. La orden de venta sigue guardada y puede volver a intentarlo.";
        }
        finally
        {
            IsPdfLoading = false;
        }
    }

    private void ClosePdfViewer() => ShowPdfViewer = false;

    private async Task PrintPdfAsync()
    {
        if (SelectedInvoice is null) return;
        try
        {
            IsPdfLoading = true;
            ClearMessages();
            await EnsurePdfAsync();
            var opened = await JS.InvokeAsync<bool>("northWindPdf.print", PdfBase64);
            if (!opened)
                ErrorMessage = "El navegador bloqueó la ventana de impresión. Permita ventanas emergentes para este sitio e intente nuevamente.";
        }
        catch
        {
            ErrorMessage = "No pudimos abrir la impresión del PDF. Vuelva a intentarlo.";
        }
        finally
        {
            IsPdfLoading = false;
        }
    }

    private async Task OpenPdfTabAsync()
    {
        if (SelectedInvoice is null) return;
        try
        {
            IsPdfLoading = true;
            ClearMessages();
            await EnsurePdfAsync();
            var opened = await JS.InvokeAsync<bool>("northWindPdf.open", PdfBase64);
            if (!opened)
                ErrorMessage = "El navegador bloqueó la nueva pestaña. Permita ventanas emergentes para este sitio e intente nuevamente.";
        }
        catch
        {
            ErrorMessage = "No pudimos abrir el PDF en una nueva pestaña.";
        }
        finally
        {
            IsPdfLoading = false;
        }
    }

    private async Task DownloadPdfAsync()
    {
        if (SelectedInvoice is null) return;
        try
        {
            IsPdfLoading = true;
            ClearMessages();
            await EnsurePdfAsync();
            await JS.InvokeVoidAsync("northWindPdf.download", PdfBase64, $"{SelectedInvoice.InvoiceNumber}.pdf");
            InformationMessage = $"La orden de venta {SelectedInvoice.InvoiceNumber} se preparó para descarga correctamente.";
        }
        catch
        {
            ErrorMessage = "No pudimos descargar el PDF. La orden de venta no se ha modificado; vuelva a intentarlo.";
        }
        finally
        {
            IsPdfLoading = false;
        }
    }

    private void ResetPdfCacheIfNeeded(int orderId)
    {
        if (PdfOrderId == orderId) return;
        PdfOrderId = null;
        PdfBase64 = string.Empty;
        PdfDataUrl = string.Empty;
        ShowPdfViewer = false;
    }

    private void ClearMessages()
    {
        ErrorMessage = string.Empty;
        InformationMessage = string.Empty;
    }
}
