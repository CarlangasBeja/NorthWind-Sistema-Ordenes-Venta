@inject ISalesQueriesGateway Gateway

@if (IsOpen)
{
    <div class="nw-modal-backdrop" role="presentation">
        <section class="nw-modal nw-search-modal" role="dialog" aria-modal="true" aria-labelledby="customerSearchTitle">
            <header class="nw-modal-header">
                <div>
                    <span class="nw-kicker">BÚSQUEDA INTELIGENTE DE CLIENTES</span>
                    <h2 id="customerSearchTitle">Seleccionar cliente</h2>
                    <p>Elija cómo desea buscar para obtener resultados más precisos.</p>
                </div>
                <button type="button" class="nw-icon-button" @onclick="CloseAsync" aria-label="Cerrar ventana">×</button>
            </header>

            <div class="nw-modal-body">
                <div class="nw-filter-panel">
                    <div class="nw-filter-heading">
                        <div>
                            <strong>Buscar por</strong>
                            <span>Seleccione el dato que conoce del cliente.</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearSearchAsync" disabled="@IsLoading">Limpiar filtros</button>
                    </div>

                    <div class="nw-filter-options" role="group" aria-label="Criterio de búsqueda de clientes">
                        <button type="button" class="nw-filter-chip @(SearchField == "code" ? "is-active" : string.Empty)" @onclick="SearchByCodeAsync">
                            <span class="nw-filter-chip-icon">#</span>
                            <span><strong>Código</strong><small>Ej.: ALFKI</small></span>
                        </button>
                        <button type="button" class="nw-filter-chip @(SearchField == "name" ? "is-active" : string.Empty)" @onclick="SearchByNameAsync">
                            <span class="nw-filter-chip-icon">Aa</span>
                            <span><strong>Nombre</strong><small>Ej.: Alfreds</small></span>
                        </button>
                        <button type="button" class="nw-filter-chip @(SearchField == "all" ? "is-active" : string.Empty)" @onclick="SearchAllAsync">
                            <span class="nw-filter-chip-icon">⌕</span>
                            <span><strong>Cualquier dato</strong><small>Búsqueda flexible</small></span>
                        </button>
                    </div>

                    <div class="nw-smart-search-row">
                        <div class="nw-search-input-wrap">
                            <span class="nw-search-input-icon">⌕</span>
                            <input class="form-control form-control-lg"
                                   value="@SearchText"
                                   @oninput="OnSearchInput"
                                   @onkeydown="HandleSearchKeyDown"
                                   placeholder="@SearchPlaceholder"
                                   aria-label="Buscar cliente" />
                            @if (!string.IsNullOrWhiteSpace(SearchText))
                            {
                                <button type="button" class="nw-input-clear" @onclick="ClearTextAsync" aria-label="Limpiar texto">×</button>
                            }
                        </div>
                        <button type="button" class="btn btn-primary px-4" @onclick="SearchAsync" disabled="@IsLoading">
                            @(IsLoading ? "Buscando..." : "Buscar cliente")
                        </button>
                    </div>

                    <div class="nw-filter-help">
                        <span class="nw-info-icon">i</span>
                        <span>@SearchHelp</span>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="nw-feedback nw-feedback-danger mt-3" role="alert">
                        <div class="nw-feedback-icon">×</div>
                        <div class="nw-feedback-body">
                            <strong>No pudimos consultar los clientes</strong>
                            <p>@ErrorMessage</p>
                            <button type="button" class="btn btn-sm btn-outline-danger mt-2" @onclick="SearchAsync">Reintentar</button>
                        </div>
                    </div>
                }

                @if (IsLoading)
                {
                    <div class="nw-loading-block mt-3">
                        <span class="nw-spinner" aria-hidden="true"></span>
                        <strong>Consultando clientes...</strong>
                        <span>Estamos verificando la información comercial y el saldo del cliente.</span>
                    </div>
                }
                else if (string.IsNullOrWhiteSpace(ErrorMessage) && (Result is null || Result.Items.Count == 0))
                {
                    <div class="nw-empty-block mt-3">
                        <div class="nw-empty-icon">⌕</div>
                        <strong>No encontramos clientes</strong>
                        <span>@EmptyMessage</span>
                    </div>
                }
                else if (string.IsNullOrWhiteSpace(ErrorMessage) && Result is not null)
                {
                    <div class="nw-result-meta">
                        <span><strong>@Result.TotalItems</strong> cliente(s) encontrado(s)</span>
                        <span>Página @Result.Page de @(Math.Max(Result.TotalPages, 1))</span>
                    </div>

                    <div class="table-responsive nw-table-shell">
                        <table class="table table-hover align-middle nw-data-table mb-0">
                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Cliente</th>
                                    <th>Estado comercial</th>
                                    <th class="text-end">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var customer in Result.Items)
                                {
                                    var isBlocked = customer.CurrentBalance > 0;
                                    <tr class="@(isBlocked ? "nw-row-muted" : string.Empty)">
                                        <td data-label="Código"><span class="nw-code-chip">@customer.Id</span></td>
                                        <td data-label="Cliente"><strong>@customer.Name</strong></td>
                                        <td data-label="Estado">
                                            @if (isBlocked)
                                            {
                                                <span class="nw-status-pill nw-status-warning">Saldo pendiente: @Money(customer.CurrentBalance)</span>
                                                <small class="nw-cell-note">Debe cancelar el saldo antes de registrar otra compra.</small>
                                            }
                                            else
                                            {
                                                <span class="nw-status-pill nw-status-success">Habilitado para comprar</span>
                                            }
                                        </td>
                                        <td data-label="Acción" class="text-end">
                                            @if (isBlocked)
                                            {
                                                <button type="button" class="btn btn-sm btn-light" disabled title="El cliente debe cancelar su saldo pendiente antes de registrar otra venta.">No disponible</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-primary" @onclick="() => SelectAsync(customer)">Seleccionar</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="nw-pagination">
                        <button type="button" class="btn btn-outline-secondary" disabled="@(Result.Page <= 1 || IsLoading)" @onclick="PreviousPageAsync">← Anterior</button>
                        <span>Mostrando página <strong>@Result.Page</strong> de <strong>@(Math.Max(Result.TotalPages, 1))</strong></span>
                        <button type="button" class="btn btn-outline-secondary" disabled="@(Result.Page >= Result.TotalPages || IsLoading)" @onclick="NextPageAsync">Siguiente →</button>
                    </div>
                }
            </div>
        </section>
    </div>
}

@code {
    private static string Money(decimal value) => $"$ {value:N2}";
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<CustomerSearchItemDto> OnSelected { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private const int PageSize = 5;
    private bool WasOpen;
    private bool IsLoading;
    private string SearchText = string.Empty;
    private string SearchField = "code";
    private string ErrorMessage = string.Empty;
    private PagedResultDto<CustomerSearchItemDto>? Result;

    private string SearchPlaceholder => SearchField switch
    {
        "code" => "Escriba el código del cliente, por ejemplo ALFKI",
        "name" => "Escriba el nombre o una parte del nombre",
        _ => "Escriba código o nombre del cliente"
    };

    private string SearchHelp => SearchField switch
    {
        "code" => "La búsqueda se realizará únicamente sobre el código del cliente.",
        "name" => "Puede escribir una palabra completa o una parte del nombre del cliente.",
        _ => "El sistema buscará coincidencias tanto en código como en nombre."
    };

    private string EmptyMessage => string.IsNullOrWhiteSpace(SearchText)
        ? "No existen clientes para mostrar en este momento."
        : $"No hay coincidencias buscando por {SearchFieldLabel.ToLowerInvariant()}. Revise el dato e intente nuevamente.";

    private string SearchFieldLabel => SearchField switch
    {
        "code" => "Código",
        "name" => "Nombre",
        _ => "Cualquier dato"
    };

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !WasOpen)
        {
            SearchText = string.Empty;
            SearchField = "code";
            await LoadAsync(1);
        }
        WasOpen = IsOpen;
    }

    private void OnSearchInput(ChangeEventArgs args) => SearchText = args.Value?.ToString() ?? string.Empty;

    private async Task HandleSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !IsLoading)
            await SearchAsync();
    }

    private Task SearchByCodeAsync() => ChangeFieldAsync("code");
    private Task SearchByNameAsync() => ChangeFieldAsync("name");
    private Task SearchAllAsync() => ChangeFieldAsync("all");

    private async Task ChangeFieldAsync(string field)
    {
        SearchField = field;
        SearchText = string.Empty;
        await LoadAsync(1);
    }

    private async Task ClearTextAsync()
    {
        SearchText = string.Empty;
        await LoadAsync(1);
    }

    private async Task ClearSearchAsync()
    {
        SearchField = "code";
        SearchText = string.Empty;
        await LoadAsync(1);
    }

    private Task SearchAsync() => LoadAsync(1);

    private async Task PreviousPageAsync()
    {
        if (Result is not null && Result.Page > 1)
            await LoadAsync(Result.Page - 1);
    }

    private async Task NextPageAsync()
    {
        if (Result is not null && Result.Page < Result.TotalPages)
            await LoadAsync(Result.Page + 1);
    }

    private async Task LoadAsync(int page)
    {
        try
        {
            IsLoading = true;
            ErrorMessage = string.Empty;
            Result = await Gateway.SearchCustomersAsync(SearchText.Trim(), SearchField, page, PageSize);
        }
        catch (HttpRequestException ex)
        {
            ErrorMessage = ex.StatusCode switch
            {
                System.Net.HttpStatusCode.Unauthorized => "Su sesión venció. Cierre esta ventana e inicie sesión nuevamente para continuar.",
                System.Net.HttpStatusCode.Forbidden => "Su usuario no tiene permiso para consultar clientes.",
                _ => "No fue posible comunicarnos con el servicio de clientes. Verifique que la API esté ejecutándose y vuelva a intentarlo."
            };
        }
        catch
        {
            ErrorMessage = "Ocurrió un problema inesperado al consultar clientes. No se realizó ningún cambio; puede volver a intentarlo.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SelectAsync(CustomerSearchItemDto customer)
    {
        if (customer.CurrentBalance > 0) return;
        await OnSelected.InvokeAsync(customer);
        await OnClose.InvokeAsync();
    }

    private Task CloseAsync() => OnClose.InvokeAsync();
}
