@inject ISalesQueriesGateway Gateway

@if (IsOpen)
{
    <div class="nw-modal-backdrop" role="presentation">
        <section class="nw-modal nw-search-modal" role="dialog" aria-modal="true" aria-labelledby="productSearchTitle">
            <header class="nw-modal-header">
                <div>
                    <span class="nw-kicker">CATÁLOGO INTELIGENTE</span>
                    <h2 id="productSearchTitle">Seleccionar producto</h2>
                    <p>Filtre por ID o nombre. Solo se muestran productos con stock disponible.</p>
                </div>
                <button type="button" class="nw-icon-button" @onclick="CloseAsync" aria-label="Cerrar ventana">×</button>
            </header>

            <div class="nw-modal-body">
                <div class="nw-filter-panel">
                    <div class="nw-filter-heading">
                        <div>
                            <strong>Buscar por</strong>
                            <span>Seleccione el dato que conoce del producto.</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearSearchAsync" disabled="@IsLoading">Limpiar filtros</button>
                    </div>

                    <div class="nw-filter-options" role="group" aria-label="Criterio de búsqueda de productos">
                        <button type="button" class="nw-filter-chip @(SearchField == "id" ? "is-active" : string.Empty)" @onclick="SearchByIdAsync">
                            <span class="nw-filter-chip-icon">#</span>
                            <span><strong>ID</strong><small>Ej.: 1</small></span>
                        </button>
                        <button type="button" class="nw-filter-chip @(SearchField == "name" ? "is-active" : string.Empty)" @onclick="SearchByNameAsync">
                            <span class="nw-filter-chip-icon">Aa</span>
                            <span><strong>Nombre</strong><small>Ej.: Chai</small></span>
                        </button>
                        <button type="button" class="nw-filter-chip @(SearchField == "all" ? "is-active" : string.Empty)" @onclick="SearchAllAsync">
                            <span class="nw-filter-chip-icon">⌕</span>
                            <span><strong>Cualquier dato</strong><small>Búsqueda flexible</small></span>
                        </button>
                    </div>

                    <div class="nw-smart-search-row">
                        <div class="nw-search-input-wrap">
                            <span class="nw-search-input-icon">⌕</span>
                            <input class="form-control form-control-lg"
                                   value="@SearchText"
                                   @oninput="OnSearchInput"
                                   @onkeydown="HandleSearchKeyDown"
                                   inputmode="@(SearchField == "id" ? "numeric" : "text")"
                                   placeholder="@SearchPlaceholder"
                                   aria-label="Buscar producto" />
                            @if (!string.IsNullOrWhiteSpace(SearchText))
                            {
                                <button type="button" class="nw-input-clear" @onclick="ClearTextAsync" aria-label="Limpiar texto">×</button>
                            }
                        </div>
                        <button type="button" class="btn btn-primary px-4" @onclick="SearchAsync" disabled="@IsLoading">
                            @(IsLoading ? "Buscando..." : "Buscar producto")
                        </button>
                    </div>

                    <div class="nw-filter-help">
                        <span class="nw-info-icon">i</span>
                        <span>@SearchHelp</span>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="nw-feedback nw-feedback-danger mt-3" role="alert">
                        <div class="nw-feedback-icon">×</div>
                        <div class="nw-feedback-body">
                            <strong>No pudimos consultar los productos</strong>
                            <p>@ErrorMessage</p>
                            <button type="button" class="btn btn-sm btn-outline-danger mt-2" @onclick="SearchAsync">Reintentar</button>
                        </div>
                    </div>
                }

                @if (IsLoading)
                {
                    <div class="nw-loading-block mt-3">
                        <span class="nw-spinner" aria-hidden="true"></span>
                        <strong>Consultando productos...</strong>
                        <span>Estamos verificando precio y stock disponible.</span>
                    </div>
                }
                else if (string.IsNullOrWhiteSpace(ErrorMessage) && (Result is null || Result.Items.Count == 0))
                {
                    <div class="nw-empty-block mt-3">
                        <div class="nw-empty-icon">⌕</div>
                        <strong>No encontramos productos disponibles</strong>
                        <span>@EmptyMessage</span>
                    </div>
                }
                else if (string.IsNullOrWhiteSpace(ErrorMessage) && Result is not null)
                {
                    <div class="nw-result-meta">
                        <span><strong>@Result.TotalItems</strong> producto(s) disponible(s)</span>
                        <span>Página @Result.Page de @(Math.Max(Result.TotalPages, 1))</span>
                    </div>

                    <div class="table-responsive nw-table-shell">
                        <table class="table table-hover align-middle nw-data-table mb-0">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Producto</th>
                                    <th>Precio unitario</th>
                                    <th>Disponibilidad</th>
                                    <th class="text-end">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var product in Result.Items)
                                {
                                    var alreadyAdded = ExcludedProductIds?.Contains(product.Id) == true;
                                    <tr class="@(alreadyAdded ? "nw-row-muted" : string.Empty)">
                                        <td data-label="ID"><span class="nw-code-chip">#@product.Id</span></td>
                                        <td data-label="Producto"><strong>@product.Name</strong></td>
                                        <td data-label="Precio"><strong>@Money(product.UnitPrice)</strong></td>
                                        <td data-label="Stock">
                                            @if (product.UnitsInStock <= 5)
                                            {
                                                <span class="nw-status-pill nw-status-warning">Stock bajo · @product.UnitsInStock unidad(es)</span>
                                                <small class="nw-cell-note">Verifique la cantidad antes de agregarlo.</small>
                                            }
                                            else
                                            {
                                                <span class="nw-status-pill nw-status-success">@product.UnitsInStock unidades disponibles</span>
                                            }
                                        </td>
                                        <td data-label="Acción" class="text-end">
                                            @if (alreadyAdded)
                                            {
                                                <button type="button" class="btn btn-sm btn-light" disabled title="Este producto ya está incluido en la orden.">Ya agregado</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-primary" @onclick="() => SelectAsync(product)">Seleccionar</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="nw-pagination">
                        <button type="button" class="btn btn-outline-secondary" disabled="@(Result.Page <= 1 || IsLoading)" @onclick="PreviousPageAsync">← Anterior</button>
                        <span>Mostrando página <strong>@Result.Page</strong> de <strong>@(Math.Max(Result.TotalPages, 1))</strong></span>
                        <button type="button" class="btn btn-outline-secondary" disabled="@(Result.Page >= Result.TotalPages || IsLoading)" @onclick="NextPageAsync">Siguiente →</button>
                    </div>
                }
            </div>
        </section>
    </div>
}

@code {
    private static string Money(decimal value) => $"$ {value:N2}";
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public IReadOnlyCollection<int>? ExcludedProductIds { get; set; }
    [Parameter] public EventCallback<ProductSearchItemDto> OnSelected { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private const int PageSize = 5;
    private bool WasOpen;
    private bool IsLoading;
    private string SearchText = string.Empty;
    private string SearchField = "id";
    private string ErrorMessage = string.Empty;
    private PagedResultDto<ProductSearchItemDto>? Result;

    private string SearchPlaceholder => SearchField switch
    {
        "id" => "Escriba el ID numérico del producto, por ejemplo 1",
        "name" => "Escriba el nombre o una parte del nombre",
        _ => "Escriba ID o nombre del producto"
    };

    private string SearchHelp => SearchField switch
    {
        "id" => "El ID debe ser numérico. La coincidencia será exacta.",
        "name" => "Puede escribir una palabra completa o una parte del nombre del producto.",
        _ => "El sistema intentará identificar si escribió un ID o un nombre."
    };

    private string EmptyMessage => string.IsNullOrWhiteSpace(SearchText)
        ? "No existen productos con stock disponible para mostrar."
        : "No hay coincidencias con el filtro seleccionado. Recuerde que los productos sin stock no aparecen.";

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !WasOpen)
        {
            SearchText = string.Empty;
            SearchField = "id";
            await LoadAsync(1);
        }
        WasOpen = IsOpen;
    }

    private void OnSearchInput(ChangeEventArgs args) => SearchText = args.Value?.ToString() ?? string.Empty;

    private async Task HandleSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !IsLoading)
            await SearchAsync();
    }

    private Task SearchByIdAsync() => ChangeFieldAsync("id");
    private Task SearchByNameAsync() => ChangeFieldAsync("name");
    private Task SearchAllAsync() => ChangeFieldAsync("all");

    private async Task ChangeFieldAsync(string field)
    {
        SearchField = field;
        SearchText = string.Empty;
        await LoadAsync(1);
    }

    private async Task ClearTextAsync()
    {
        SearchText = string.Empty;
        await LoadAsync(1);
    }

    private async Task ClearSearchAsync()
    {
        SearchField = "id";
        SearchText = string.Empty;
        await LoadAsync(1);
    }

    private Task SearchAsync() => LoadAsync(1);

    private async Task PreviousPageAsync()
    {
        if (Result is not null && Result.Page > 1)
            await LoadAsync(Result.Page - 1);
    }

    private async Task NextPageAsync()
    {
        if (Result is not null && Result.Page < Result.TotalPages)
            await LoadAsync(Result.Page + 1);
    }

    private async Task LoadAsync(int page)
    {
        try
        {
            IsLoading = true;
            ErrorMessage = string.Empty;
            Result = await Gateway.SearchProductsAsync(SearchText.Trim(), SearchField, page, PageSize);
        }
        catch (HttpRequestException ex)
        {
            ErrorMessage = ex.StatusCode switch
            {
                System.Net.HttpStatusCode.Unauthorized => "Su sesión venció. Cierre esta ventana e inicie sesión nuevamente para continuar.",
                System.Net.HttpStatusCode.Forbidden => "Su usuario no tiene permiso para consultar productos.",
                _ => "No fue posible comunicarnos con el servicio de productos. Verifique que la API esté ejecutándose y vuelva a intentarlo."
            };
        }
        catch
        {
            ErrorMessage = "Ocurrió un problema inesperado al consultar productos. No se realizó ningún cambio; puede volver a intentarlo.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SelectAsync(ProductSearchItemDto product)
    {
        if (ExcludedProductIds?.Contains(product.Id) == true) return;
        await OnSelected.InvokeAsync(product);
        await OnClose.InvokeAsync();
    }

    private Task CloseAsync() => OnClose.InvokeAsync();
}
